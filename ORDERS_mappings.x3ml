                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">Name_Assignment_Timespan</arg>
                              <arg name="term" type="xpath">substring-after(text(), ', ')</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">substring-after(text(), ', ')</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC13_is_carried_out_by</relationship>
               </target_relation>
            </path>
