<?xml version="1.0" encoding="UTF-8"?>
<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="https://isl.ics.forth.gr/x3ml/schema/x3ml.xsd">
   <info>
      <title>SemantyFish: CLASSES_Mappings</title>
      <general_description>Mappings for the table CLASSES from FishBase database</general_description>
      <source>
         <source_info>
            <source_schema schema_file="CLASSES.xml" type="xml" version="">CLASSES</source_schema>
            <namespaces>
               <namespace prefix="" uri=""/>
            </namespaces>
         </source_info>
      </source>
      <target>
         <target_info>
            <target_schema schema_file="CIDOC_CRM_v7.1.1.rdfs" type="rdfs" version="">CIDOC CRM</target_schema>
            <namespaces>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
            </namespaces>
         </target_info>
         <target_info>
            <target_schema schema_file="marinetlo_semantyFish_ext5_1.owl"
                           type="owl"
                           version="">marinetlo_semantyFish_ext5_1</target_schema>
            <namespaces>
               <namespace prefix="marinetlo"
                          uri="http://www.ics.forth.gr/isl/ontology/MarineTLO/"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="skos" uri="http://www.w3.org/2004/02/skos/core#"/>
               <namespace prefix="dcterms" uri="http://purl.org/dc/terms/"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="vs" uri="http://www.w3.org/2003/06/sw-vocab-status/ns#"/>
               <namespace prefix="foaf" uri="http://xmlns.com/foaf/0.1/"/>
               <namespace prefix="dc" uri="http://purl.org/dc/elements/1.1/"/>
               <namespace prefix="base" uri="http://www.ics.forth.gr/isl/ontology/MarineTLO/"/>
            </namespaces>
         </target_info>
      </target>
      <mapping_info>
         <mapping_created_by_org/>
         <mapping_created_by_person/>
         <in_collaboration_with/>
      </mapping_info>
      <example_data_info>
         <example_data_from/>
         <example_data_contact_person/>
         <example_data_source_record/>
         <generator_policy_info/>
         <example_data_target_record/>
         <thesaurus_info/>
      </example_data_info>
   </info>
   <namespaces>
      <namespace prefix="pref" uri="https://semantyfish.github.io/kb/resource/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>//CLASSES</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BT22_Class</type>
                  <type>crm:E55_Type</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">Class</arg>
                     <arg name="term" type="xpath">C_ClassNum/text()</arg>
                  </instance_generator>
                  <label_generator name="SimpleLabel">
                     <arg name="label" type="xpath">C_Class/text()</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_Class</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Class</source_node>
               <target_node>
                  <entity variable="ClassAppellation">
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">text()</arg>
                        <arg name="term" type="constant">Appellation</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_CommonName</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_CommonName</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">text()</arg>
                        <arg name="term" type="constant">Appellation</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT32_Persistent_Type</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="constant">http://rs.tdwg.org/dwc/terms/vernacularName</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">vernacular name</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Synonym</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <equals value="true">text()</equals>
                  </if>
                  <relationship>marinetlo:LX1_is_identified_by</relationship>
                  <entity variable="ClassAppellation">
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="UUID"/>
                  </entity>
                  <relationship>marinetlo:LX3_has_type</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Synonym</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT32_Persistent_Type</type>
                     <instance_generator name="TypeURI">
                        <arg name="type" type="constant">Synonym</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="constant">synonym</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_SpeciesCount</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <exists>text()</exists>
                  </if>
                  <relationship>marinetlo:LX6_type_was_attributed_by</relationship>
                  <entity>
                     <type>marinetlo:BC44_Attribute_Assignment</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Class/', ../C_C_ClassNum/text())</arg>
                        <arg name="term" type="constant">FB_Species_Record_Count_Calculation</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">FB record count calculation of species for</arg>
                        <arg name="term2" type="xpath">../C_Class/text()</arg>
                     </label_generator>
                  </entity>
                  <relationship>marinetlo:LC9_assigned</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SpeciesCount</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC5_Dimension</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Class/', ../C_ClassNum/text())</arg>
                        <arg name="term" type="constant">FB_Species_RecordCount</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">FB record count of species for</arg>
                        <arg name="term2" type="xpath">../C_Class/text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC20_has_value</relationship>
                        <entity>
                           <type>owl:real</type>
                           <instance_generator name="Literal">
                              <arg name="text" type="xpath">text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LC21_has_unit</relationship>
                        <entity>
                           <type>marinetlo:BC55_Measurement_Unit</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">No_of_Species_Records</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">number of species records</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_BodyShapeI</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <exists>text()</exists>
                  </if>
                  <relationship>marinetlo:LT6_usually_is_subject_of</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_BodyShapeI</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT35_Property_Type</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">body_shape</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">resource_type</arg>
                              <arg name="term" type="constant">body_shape</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">body shape</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_WaterSalinity</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <exists>text()</exists>
                  </if>
                  <relationship>marinetlo:LT3_usually_is_component_of</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_WaterSalinity</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT7_Ecosystem_Type</type>
                     <instance_generator name="TypeURI">
                        <arg name="type" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">resource_type</arg>
                              <arg name="term" type="constant">water_salinity</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">water salinity</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Remarks</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <exists>text()</exists>
                  </if>
                  <relationship>marinetlo:O3_has_note</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Remarks</source_node>
               <target_node>
                  <entity>
                     <type>xsd:string</type>
                     <instance_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
      </mapping>
   </mappings>
</x3ml>
