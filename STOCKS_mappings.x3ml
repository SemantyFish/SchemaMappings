                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">Maximum_Temperature</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">maximum temperature</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
