                           <type>marinetlo:BC55_Measurement_Unit</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">Celsius</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">Celsius</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT35_Property_Type</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">Minimum_Temperature</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">minimum temperature</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
