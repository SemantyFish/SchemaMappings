   <mappings>
      <mapping>
         <domain>
            <source_node>//STOCKS</source_node>
            <target_node>
               <if>
                  <exists>C_StockDefsGeneral/text()</exists>
               </if>
               <entity>
                  <type>marinetlo:BC75_Stock</type>
                  <type>crm:E18_Physical_Thing</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">Stock</arg>
                     <arg name="term" type="xpath">C_StockCode/text()</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="term1" type="xpath">concat('species ID ', C_SpecCode/text())</arg>
                     <arg name="term2" type="xpath">concat('stock ID ', C_StockCode/text())</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_SynOC</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <not>
                        <if>
                           <equals value="">text()</equals>
                        </if>
                     </not>
                  </if>
                  <relationship>marinetlo:LC1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SynOC</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC32_Identifier</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Species/', ../C_SpecCode/text())</arg>
                        <arg name="term" type="xpath">concat('Scientific_Name_Id/', text(), '/Original_Combination')</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT32_Persistent_Type</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">Original_Combination_Id</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">original combination id</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_SpecCode</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX3_has_type</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SpecCode</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT27_Species</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Species</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link> 
         <link>
            <path>
               <source_relation>
                  <relation>C_StockDefsGeneral</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC10_belongs_to</relationship>
                  <entity variable="habitat">
                     <type>marinetlo:BC14_Ecosystem_Environment</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">stock_distribution_habitat</arg>
                        <arg name="term" type="xpath">../C_StockCode/text()</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">habitat of</arg>
                        <arg name="term2" type="xpath">concat('species ID ', ../C_SpecCode/text(), ' stock ID ', ../C_StockCode/text())</arg>
                     </label_generator>
                  </entity>
                  <relationship>marinetlo:LC27_has_section</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_StockDefsGeneral</source_node>
               <target_node>
                  <entity variable="place_name">
                     <type>marinetlo:BC3_Place</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">stock_distribution_area</arg>
                        <arg name="term" type="xpath">concat('/Stock/', ../C_StockCode/text(),'/Place/',text())</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:O3_has_note</relationship>
                        <entity>
                           <type>xsd:string</type>
                           <instance_generator name="Literal">
                              <arg name="text" type="xpath">text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_TempMin</relation>
               </source_relation>
