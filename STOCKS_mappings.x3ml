               </target_relation>
            </path>
            <range>
               <source_node>C_IUCN_Code</source_node>
               <target_node>
                  <entity variable="iucn_code">
                     <type>marinetlo:BT35_Property_Type</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Species/', ../C_SpecCode/text(), '/Stock/', ../C_StockCode/text())</arg>
                        <arg name="term" type="xpath">concat('IUCN_Code/', text())</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="constant">extinct</arg>
