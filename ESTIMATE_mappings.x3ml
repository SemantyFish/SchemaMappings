   <mappings>
      <mapping>
         <domain>
            <source_node>//ESTIMATE</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BT27_Species</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">Species</arg>
                     <arg name="term" type="xpath">C_SpecCode/text()</arg>
                  </instance_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_Calcium</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX16_was_type_of_object_used_in</relationship>
                  <entity>
                     <type>marinetlo:BC74_Data_Evaluation</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Species/', ../C_SpecCode/text())</arg>
                        <arg name="term" type="constant">Calcium_Concentration_Calculation</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">Ca concentration calculation for</arg>
                        <arg name="term2" type="xpath">concat('species ', ../C_SpecCode/text())</arg>
                     </label_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">estimate_type</arg>
                              <arg name="term" type="constant">calcium_concentration</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">calcium concentration</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC49_described_was_described_by</relationship>
                  <entity>
                     <type>marinetlo:BC9_Observable_Entity</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Species/',../C_SpecCode/text())</arg>
                        <arg name="term" type="constant">Calcium_Concentration_Median</arg>
