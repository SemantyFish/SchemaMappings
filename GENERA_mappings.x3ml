                        <arg name="term2" type="xpath">../C_GenName/text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC55_used_specific_object</relationship>
                        <entity>
                           <type>marinetlo:BC25_Linguistic_Object</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">Work_By</arg>
                              <arg name="term" type="xpath">substring-before(substring-after(../C_GenInEx/text(), 'ex '), ')')</arg>
                           </instance_generator>
                           <label_generator name="CompositeLabel">
                              <arg name="term1" type="constant">work by</arg>
                              <arg name="term2" type="xpath">substring-before(substring-after(../C_GenInEx/text(), 'ex '), ')')</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC13_is_carried_out_by</relationship>
               </target_relation>
            </path>
            <range>
