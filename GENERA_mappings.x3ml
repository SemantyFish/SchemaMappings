   <mappings>
      <mapping>
         <domain>
            <source_node>//GENERA</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BT26_Genus</type>
                  <type>crm:E55_Type</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">Genus</arg>
                     <arg name="term" type="xpath">C_GenCode/text()</arg>
                  </instance_generator>
                  <label_generator name="SimpleLabel">
