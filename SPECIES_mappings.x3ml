   <mappings>
      <mapping>
         <domain>
            <source_node>//SPECIES</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BT27_Species</type>
                  <type>crm:E55_Type</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">Species</arg>
                     <arg name="term" type="xpath">C_SpecCode/text()</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="term1" type="xpath">C_Genus/text()</arg>
                     <arg name="term2" type="xpath">C_Species/text()</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_Species</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Species</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat(../C_Genus/text(), '/', text())</arg>
                        <arg name="term" type="constant">Appellation</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">concat(../C_Genus/text(), ' ', text())</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT14_Appellation_Type</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="constant">http://rs.tdwg.org/dwc/terms/scientificName</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">scientific name</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Author</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <and>
                        <if>
                           <exists>.[contains(., ')')]</exists>
                        </if>
                        <if>
                           <exists>.[contains(., '(')]</exists>
                        </if>
                     </and>
                  </if>
                  <relationship>marinetlo:LX4_has_appellation</relationship>
                  <entity>
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat(../C_Genus/text(), '/', ../C_Species/text())</arg>
                        <arg name="term" type="constant">Appellation</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">concat(../C_Genus/text(), ' ', ../C_Species/text())</arg>
                     </label_generator>
                  </entity>
                  <relationship>marinetlo:LC12_was_attributed_by</relationship>
                  <entity>
                     <type>marinetlo:BC44_Attribute_Assignment</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Species/',../C_SpecCode/text())</arg>
                        <arg name="term" type="constant">Name_Assignment</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">name assignment for</arg>
                        <arg name="term2" type="xpath">concat(../C_Genus/text(), ' ', ../C_Species/text())</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LX6_assigned_attribute_to_type</relationship>
                        <entity>
                           <type>marinetlo:BT32_Persistent_Type</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">Species</arg>
                              <arg name="term" type="xpath">../C_SpecCode/text()</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">concat(../C_Genus/text(), ' ', ../C_Species/text())</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LC5_has_time_span</relationship>
                        <entity>
                           <type>marinetlo:BC2_Time_Span</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="xpath">concat('Species/', ../C_SpecCode/text(), '/Name_Assignment_Timespan')</arg>
                              <arg name="term" type="xpath">substring-after(substring-before(text(), ')'),', ')</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">substring-after(substring-before(text(), ')'),', ')</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>crm:P182_ends_before_or_with_the_start_of</relationship>
                        <entity>
                           <type>crm:E17_Type_Assignment</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="xpath">concat('Species/',../C_SpecCode/text())</arg>
                              <arg name="term" type="constant">Renaming</arg>
                           </instance_generator>
                           <label_generator name="CompositeLabel">
                              <arg name="term1" type="constant">renaming of </arg>
                              <arg name="term2" type="xpath">concat(../C_Genus/text(), ' ', ../C_Species/text())</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC13_is_carried_out_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Author</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC11_Person</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Person</arg>
                        <arg name="term" type="xpath">substring-after(substring-before(text(), ','),'(')</arg>
