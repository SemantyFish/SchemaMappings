      <mapping>
         <domain>
            <source_node>//FAMILIES</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BT24_Family</type>
                  <type>crm:E55_Type</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">Family</arg>
                     <arg name="term" type="xpath">C_FamCode/text()</arg>
                  </instance_generator>
                  <label_generator name="SimpleLabel">
                     <arg name="label" type="xpath">C_Family/text()</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_Family</relation>
               </source_relation>
