            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_AuthorYear</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <and>
                        <if>
                           <not>
                              <if>
                                 <exists>../C_Qualification/text()</exists>
                              </if>
                           </not>
                        </if>
                        <if>
                           <not>
                              <if>
                                 <equals value="">text()</equals>
                              </if>
                           </not>
                        </if>
                     </and>
                  </if>
                  <relationship>marinetlo:LX1_is_identified_by</relationship>
                  <entity variable="Family_Appellation">
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="UUID"/>
                  </entity>
                  <relationship>marinetlo:LC12_was_attributed_by</relationship>
                  <entity>
                     <type>marinetlo:BC44_Attribute_Assignment</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Family/', ../C_FamCode/text())</arg>
                        <arg name="term" type="constant">Name_Assignment</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">name assignment for</arg>
                        <arg name="term2" type="xpath">../C_Family/text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC5_has_time_span</relationship>
                        <entity>
                           <type>marinetlo:BC2_Time_Span</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">Name_Assignment_Timespan</arg>
                              <arg name="term" type="xpath">substring-after(text(), ', ')</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">substring-after(text(), ', ')</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC13_is_carried_out_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_AuthorYear</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC11_Person</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Person</arg>
                        <arg name="term" type="xpath">substring-before(text(), ', ')</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">substring-before(text(), ', ')</arg>
