<?xml version="1.0" encoding="UTF-8"?>
<x3ml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      source_type="xpath"
      version="1.0"
      xsi:noNamespaceSchemaLocation="https://isl.ics.forth.gr/x3ml/schema/x3ml.xsd">
   <info>
      <title>SemantyFish: FAO_AREA</title>
      <general_description>Mappings for the table Stocks [does not associate BC3 Place and BC20 Declarative Place. Goes through BC15 Water Area]</general_description>
      <source>
         <source_info>
            <source_schema schema_file="FAOAREAS.xml" type="xml" version="">FAOAREAS</source_schema>
            <namespaces>
               <namespace prefix="" uri=""/>
            </namespaces>
         </source_info>
      </source>
      <target>
         <target_info>
            <target_schema schema_file="CIDOC_CRM_v7.1.1.rdfs" type="rdfs" version="">CIDOC CRM</target_schema>
            <namespaces>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
            </namespaces>
         </target_info>
         <target_info>
            <target_schema schema_file="CIDOC_CRM_v7.1.2_PC.rdf" type="rdf" version="">CIDOC_CRM_v7.1.2_PC</target_schema>
            <namespaces>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
               <namespace prefix="crm" uri="http://www.cidoc-crm.org/cidoc-crm/"/>
            </namespaces>
         </target_info>
         <target_info>
            <target_schema schema_file="marinetlo_semantyFish_ext5_5.owl"
                           type="owl"
                           version="">marinetlo_semantyFish_ext5_5</target_schema>
            <namespaces>
               <namespace prefix="marinetlo"
                          uri="http://www.ics.forth.gr/isl/ontology/MarineTLO/"/>
               <namespace prefix="owl" uri="http://www.w3.org/2002/07/owl#"/>
               <namespace prefix="rdf" uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
               <namespace prefix="xsd" uri="http://www.w3.org/2001/XMLSchema#"/>
               <namespace prefix="skos" uri="http://www.w3.org/2004/02/skos/core#"/>
               <namespace prefix="dcterms" uri="http://purl.org/dc/terms/"/>
               <namespace prefix="rdfs" uri="http://www.w3.org/2000/01/rdf-schema#"/>
               <namespace prefix="vs" uri="http://www.w3.org/2003/06/sw-vocab-status/ns#"/>
               <namespace prefix="foaf" uri="http://xmlns.com/foaf/0.1/"/>
               <namespace prefix="dc" uri="http://purl.org/dc/elements/1.1/"/>
            </namespaces>
         </target_info>
      </target>
      <mapping_info>
         <mapping_created_by_org/>
         <mapping_created_by_person/>
         <in_collaboration_with/>
      </mapping_info>
      <example_data_info>
         <example_data_from/>
         <example_data_contact_person/>
         <example_data_source_record/>
         <generator_policy_info/>
         <example_data_target_record/>
         <thesaurus_info/>
      </example_data_info>
   </info>
   <namespaces>
      <namespace prefix="pref" uri="https://semantyfish.github.io/kb/resource/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>//FAOAREAS</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BC75_Stock</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="xpath">concat('Species/', C_SpecCode/text(), '/Stock/', C_StockCode/text(), '/FAO_Area/', C_AreaCode/text())</arg>
                     <arg name="term" type="xpath">concat('C_Code/', C_C_Code/text())</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="term1" type="xpath">concat('species ID ', C_SpecCode/text())</arg>
                     <arg name="term2" type="xpath">concat('stock ID ', C_Stockcode/text())</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_SpecCode</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX3_has_type</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SpecCode</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT27_Species</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Species</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_AreaCode</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC10_belongs_to</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_AreaCode</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC15_Water_Area</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">FAO_Area</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">FAO area</arg>
                        <arg name="term2" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>owl:sameAs</relationship>
                        <entity>
                           <type>marinetlo:BC15_Water_Area</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="xpath">concat('Species/', ../C_SpecCode/text(), '/Stock/', ../C_Stockcode/text())</arg>
                              <arg name="term" type="constant">Habitat</arg>
                           </instance_generator>
                           <label_generator name="CompositeLabel">
                              <arg name="term1" type="constant">habitat of</arg>
                              <arg name="term2" type="xpath">concat('species ID ', ../C_SpecCode/text(), ' stock ID ', ../C_Stockcode/text())</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Status</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX3_has_type</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Status</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT35_Property_Type</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Species/', ../C_SpecCode/text(), '/Stock/', ../C_Stockcode/text(), '/C_Code/', ../C_AreaCode/text())</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
      </mapping>
   </mappings>
</x3ml>
