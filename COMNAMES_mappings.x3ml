   <info>
      <title>SemantyFish: CommonNames_Mappings_IDENTIFIERS_FIRST</title>
      <general_description>Mappings for the table COMMON NAMES from FishBase database. Start from E42 Identifier add P1i identifies: E33_E41_Linguistic_Appellation in all links.</general_description>
      <source>
         <source_info>
            <source_schema schema_file="COMNAMES.xml" type="xml" version="">COMNAMES</source_schema>
            <namespaces>
               <namespace prefix="" uri=""/>
            </namespaces>
         </source_info>
      </source>
