   <mappings>
      <mapping>
         <domain>
            <source_node>//COMNAMES</source_node>
            <target_node>
               <entity>
                  <type>crm:E42_Identifier</type>
                  <type>marinetlo:BC32_Identifier</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">CommonName</arg>
                     <arg name="term" type="xpath">C_autoctr/text()</arg>
                  </instance_generator>
                  <label_generator name="SimpleLabel">
                     <arg name="label" type="xpath">C_autoctr/text()</arg>
                  </label_generator>
                  <additional>
                     <relationship>crm:P2_has_type</relationship>
                     <entity>
                        <type>crm:E55_Type</type>
                        <instance_generator name="LocalTermURI">
                           <arg name="hierarchy" type="constant">resource_type</arg>
                           <arg name="term" type="constant">common_name_code</arg>
                        </instance_generator>
                        <label_generator name="SimpleLabel">
                           <arg name="label" type="constant">common name code</arg>
                        </label_generator>
                     </entity>
                  </additional>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_ComName</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P1i_identifies</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_ComName</source_node>
               <target_node>
                  <entity variable="com_name_original">
                     <type>crm:E33_E41_Linguistic_Appellation</type>
                     <type>marinetlo:BC30_Appellation</type>
                     <type>marinetlo:BC25_Linguistic_Object</type>
                     <instance_generator name="LocalTermUri-hashed">
                        <arg name="hierarchy" type="constant">appellation</arg>
                        <arg name="term" type="xpath">concat(../C_autoctr/text(),text())</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Script</relation>
               </source_relation>
