   <namespaces>
      <namespace prefix="pref" uri="https://semantyfish.github.io/kb/resource/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>//SYNONYMS</source_node>
            <target_node>
               <if>
                  <equals value="Species">C_TaxonLevel/text()</equals>
               </if>
               <entity>
                  <type>crm:E42_Identifier</type>
                  <type>marinetlo:BC32_Identifier</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">synonym</arg>
                     <arg name="term" type="xpath">C_SynCode/text()</arg>
                  </instance_generator>
                  <label_generator name="SimpleLabel">
                     <arg name="label" type="xpath">C_SynCode/text()</arg>
                  </label_generator>
                  <additional>
                     <relationship>crm:P2_has_type</relationship>
                     <entity>
                        <type>crm:E55_Type</type>
                        <instance_generator name="TypeURI">
                           <arg name="type" type="constant">synonym_code</arg>
                        </instance_generator>
                        <label_generator name="SimpleLabel">
                           <arg name="label" type="constant">synonym code</arg>
                        </label_generator>
                     </entity>
                  </additional>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_SpecCode</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX1_identifies</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SpecCode</source_node>
               <target_node>
                  <entity variable="species_1">
                     <type>marinetlo:BT27_Species</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Species</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_SynSpecies</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P1i_identifies</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SynSpecies</source_node>
               <target_node>
                  <if>
                     <and>
                        <if>
                           <exists>text()</exists>
                        </if>
                        <if>
                           <exists>../C_SynGenus/text()</exists>
                        </if>
                     </and>
                  </if>
                  <entity variable="scientific_name">
                     <type>crm:E33_E41_Linguistic_Appellation</type>
                     <type>marinetlo:BC30_Appellation</type>
                     <type>marinetlo:BC25_Linguistic_Object</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">string-join((../C_SynGenus/text(),text()),'/')</arg>
                        <arg name="term" type="constant">Appellation</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="xpath">../C_SynGenus/text()</arg>
                        <arg name="term2" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">appellation_type</arg>
                              <arg name="term" type="constant">synonym_name</arg>
                           </instance_generator>
                           <label_generator name="Literal">
                              <arg name="text" type="constant">synonym name</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_LastEpithet</relation>
               </source_relation>
               <target_relation>
                  <relationship>crm:P1i_identifies</relationship>
                  <entity variable="scientific_name">
                     <type>crm:E33_E41_Linguistic_Appellation</type>
                     <type>marinetlo:BC30_Appellation</type>
                     <type>marinetlo:BC25_Linguistic_Object</type>
                     <instance_generator name="UUID"/>
                  </entity>
                  <relationship>crm:P106_is_composed_of</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_LastEpithet</source_node>
               <target_node>
                  <if>
                     <exists>text()</exists>
                  </if>
                  <entity>
                     <type>crm:E33_E41_Linguistic_Appellation</type>
                     <type>marinetlo:BC30_Appellation</type>
                     <type>marinetlo:BC25_Linguistic_Object</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Last_Epithet</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>crm:P2_has_type</relationship>
                        <entity>
                           <type>crm:E55_Type</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">Last_Epithet</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">last epithet</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Author</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <and>
                        <if>
                           <not>
                              <if>
                                 <exists>.[contains(., ')')]</exists>
                              </if>
                           </not>
                        </if>
                        <if>
                           <not>
                              <if>
                                 <exists>.[contains(., '(')]</exists>
                              </if>
                           </not>
                        </if>
                     </and>
                  </if>
                  <relationship>crm:P1i_identifies</relationship>
                  <entity variable="scientific_name">
                     <type>crm:E33_E41_Linguistic_Appellation</type>
                     <type>marinetlo:BC30_Appellation</type>
                     <type>marinetlo:BC25_Linguistic_Object</type>
                     <instance_generator name="UUID"/>
                  </entity>
                  <relationship>marinetlo:LC9_was_assigned_by</relationship>
                  <entity variable="scientific_name_assignment_or">
                     <type>marinetlo:BC44_Attribute_Assignment</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat(../C_SynGenus/text(), '/', ../C_SynSpecies/text())</arg>
                        <arg name="term" type="constant">Scientific_Name_Assignment</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">scientific name assignment of</arg>
                        <arg name="term2" type="xpath">concat(../C_SynGenus/text(), ' ', ../C_SynSpecies/text())</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC2_is_referred_by</relationship>
                        <entity>
                           <type>marinetlo:BC27_Publication</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">Publication</arg>
                              <arg name="term" type="xpath">text()</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">text()</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC13_is_carried_out_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Author</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC11_Person</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Person</arg>
                        <arg name="term" type="xpath">substring-before(text(), ',')</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">substring-before(text(), ',')</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Year</relation>
               </source_relation>
               <target_relation>
                  <if>
