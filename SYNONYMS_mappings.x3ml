                        <arg name="term2" type="xpath">concat(../C_SynGenus/text(), ' ', ../C_SynSpecies/text())</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC2_is_referred_by</relationship>
                        <entity>
                           <type>marinetlo:BC27_Publication</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="constant">Publication</arg>
                              <arg name="term" type="xpath">text()</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="xpath">text()</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>crm:P182_ends_before_or_with_the_start_of</relationship>
                        <entity>
                           <type>crm:E17_Type_Assignment</type>
                           <instance_generator name="LocalTermURI">
                              <arg name="hierarchy" type="xpath">concat('Species/', ../S_SpecCode/text())</arg>
                              <arg name="term" type="constant">Renaming</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC13_is_carried_out_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Author</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC11_Person</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Person</arg>
                        <arg name="term" type="xpath">substring-after(substring-before(text(), ','),'(')</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">substring-after(substring-before(text(), ','),'(')</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
