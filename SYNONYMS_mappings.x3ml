                     <instance_generator name="UUID"/>
                  </entity>
                  <relationship>marinetlo:LC5_has_time_span</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Year</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC2_Time_Span</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat(../C_SynGenus/text(), '/', ../C_SynSpecies/text(), '/Scientific_Name_Assignment')</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Author</relation>
               </source_relation>
               <target_relation>
                  <if>
                     <and>
                        <if>
                           <exists>.[contains(., ')')]</exists>
