   <info>
      <title>SemantyFish: Synonyms_Mappings_CONSOLIDATED</title>
      <general_description>Mappings for the table Synonyms (12) from FishBase database. Start from E42 Identifier add P1i identifies: E33_E41_Linguistic_Appellation in all links.</general_description>
      <source>
         <source_info>
            <source_schema schema_file="SYNONYMS.xml" type="xml" version="">SYNONYMS</source_schema>
            <namespaces>
               <namespace prefix="" uri=""/>
            </namespaces>
         </source_info>
      </source>
