   <mappings>
      <mapping>
         <domain>
            <source_node>//COUNTRY</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BC75_Stock</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="xpath">concat('Species/', C_SpecCode/text(), '/Stock/', C_Stockcode/text())</arg>
                     <arg name="term" type="xpath">concat('C_Code/', C_C_Code/text())</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="term1" type="xpath">concat('species ID ', C_SpecCode/text())</arg>
                     <arg name="term2" type="xpath">concat('stock ID ', C_Stockcode/text())</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_SpecCode</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LX3_has_type</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_SpecCode</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BT27_Species</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Species</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_C_Code</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC10_belongs_to</relationship>
                  <entity>
                     <type>marinetlo:BC15_Water_Area</type>
                     <instance_generator name="ThingComplex2URI">
                        <arg name="type" type="xpath">concat('Species/', ../C_SpecCode/text(), '/Stock/', ../C_Stockcode/text())</arg>
                        <arg name="id" type="constant">Habitat</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">habitat of</arg>
                        <arg name="term2" type="xpath">concat('species ID ', ../C_SpecCode/text(), ' stock ID ', ../C_Stockcode/text())</arg>
                     </label_generator>
                  </entity>
                  <relationship>marinetlo:LC27_has_section</relationship>
                  <entity>
                     <type>marinetlo:BC3_Place</type>
                     <instance_generator name="ThingComplex2URI">
                        <arg name="type" type="xpath">concat('Species/', ../C_SpecCode/text(), '/Stock/', ../C_Stockcode/text())</arg>
                        <arg name="id" type="constant">Habitat/Geographical_Location</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">geographical location of </arg>
                        <arg name="term2" type="xpath">concat(../C_SpecCode/text(), ' ', ../C_Stockcode/text())</arg>
                     </label_generator>
                  </entity>
                  <relationship>marinetlo:LC45_is_spatial_projection_of</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_C_Code</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC72_SpaceTime_Volume</type>
                     <type>marinetlo:BC81_Country</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Country_Code</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
