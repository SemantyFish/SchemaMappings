                     </additional>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT3_Physical_Thing_Type</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="constant">http://vocab.getty.edu/page/aat/300055621</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">area (measurement)</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_LatDeg</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC27_has_section</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_LatDeg</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC20_Declarative_Place</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Centerpoint</arg>
                        <arg name="term" type="xpath">concat("(", text(), "°", ../C_LatMin/text(), "'", ../C_N_S/text(), ",",../C_LongDeg/text(), "°", ../C_LongMin/text(), "'", ../C_E_W/text(), ")")</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">concat("(", text(), "°", ../C_LatMin/text(), "'", ../C_N_S/text(), ",",../C_LongDeg/text(), "°", ../C_LongMin/text(), "'", ../C_E_W/text(), ")")</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
      </mapping>
