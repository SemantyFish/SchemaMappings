                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT3_Physical_Thing_Type</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="constant">http://vocab.getty.edu/page/aat/300386915</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">undersea shelves</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
                  <relationship>marinetlo:LC19_has_dimension</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Shelf</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC5_Dimension</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Habitat/', ../C_AreaCode/text(), '/Shelf')</arg>
                        <arg name="term" type="constant">Dimension</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">dimension of shelf for</arg>
                        <arg name="term2" type="xpath">../C_FAO/text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC20_has_value</relationship>
                        <entity>
                           <type>owl:real</type>
                           <instance_generator name="Literal">
                              <arg name="text" type="xpath">text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LC21_has_unit</relationship>
                        <entity>
                           <type>marinetlo:BC55_Measurement_Unit</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">km^2</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">km^2</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT3_Physical_Thing_Type</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="constant">http://vocab.getty.edu/page/aat/300055621</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">area (measurement)</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_EEZarea</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC16_is_composed_of</relationship>
                  <entity>
