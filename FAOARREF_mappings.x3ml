   <namespaces>
      <namespace prefix="pref" uri="https://semantyfish.github.io/kb/resource/"/>
   </namespaces>
   <mappings>
      <mapping>
         <domain>
            <source_node>//FAOARREF</source_node>
            <target_node>
               <entity>
                  <type>marinetlo:BC15_Water_Area</type>
                  <instance_generator name="LocalTermURI">
                     <arg name="hierarchy" type="constant">FAO_Area</arg>
                     <arg name="term" type="xpath">C_AreaCode/text()</arg>
                  </instance_generator>
                  <label_generator name="CompositeLabel">
                     <arg name="term1" type="constant">FAO area</arg>
                     <arg name="term2" type="xpath">C_AreaCode/text()</arg>
                  </label_generator>
               </entity>
            </target_node>
         </domain>
         <link>
            <path>
               <source_relation>
                  <relation>C_FAO</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC1_is_identified_by</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_FAO</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC30_Appellation</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="constant">Appellation</arg>
                        <arg name="term" type="xpath">text()</arg>
                     </instance_generator>
                     <label_generator name="SimpleLabel">
                        <arg name="label" type="xpath">text()</arg>
                     </label_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Note</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:O3_has_note</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Note</source_node>
               <target_node>
                  <entity>
                     <type>xsd:string</type>
                     <instance_generator name="Literal">
                        <arg name="text" type="xpath">text()</arg>
                     </instance_generator>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Coastline</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC16_is_composed_of</relationship>
                  <entity>
                     <type>marinetlo:BC14_Ecosystem_Environment</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Habitat/', ../C_AreaCode/text())</arg>
                        <arg name="term" type="constant">Coastline</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">coastline for</arg>
                        <arg name="term2" type="xpath">../C_FAO/text()</arg>
                     </label_generator>
                  </entity>
                  <relationship>marinetlo:LC19_has_dimension</relationship>
               </target_relation>
            </path>
            <range>
               <source_node>C_Coastline</source_node>
               <target_node>
                  <entity>
                     <type>marinetlo:BC5_Dimension</type>
                     <instance_generator name="LocalTermURI">
                        <arg name="hierarchy" type="xpath">concat('Habitat/', ../C_AreaCode/text(), '/Coastline')</arg>
                        <arg name="term" type="constant">Dimension</arg>
                     </instance_generator>
                     <label_generator name="CompositeLabel">
                        <arg name="term1" type="constant">dimension of coastline for</arg>
                        <arg name="term2" type="xpath">../C_FAO/text()</arg>
                     </label_generator>
                     <additional>
                        <relationship>marinetlo:LC20_has_value</relationship>
                        <entity>
                           <type>owl:real</type>
                           <instance_generator name="Literal">
                              <arg name="text" type="xpath">text()</arg>
                           </instance_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LC21_has_unit</relationship>
                        <entity>
                           <type>marinetlo:BC55_Measurement_Unit</type>
                           <instance_generator name="TypeURI">
                              <arg name="type" type="constant">km</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">km</arg>
                           </label_generator>
                        </entity>
                     </additional>
                     <additional>
                        <relationship>marinetlo:LX3_has_type</relationship>
                        <entity>
                           <type>marinetlo:BT3_Physical_Thing_Type</type>
                           <instance_generator name="URIorUUID">
                              <arg name="text" type="constant">http://vocab.getty.edu/page/aat/300055645</arg>
                           </instance_generator>
                           <label_generator name="SimpleLabel">
                              <arg name="label" type="constant">length</arg>
                           </label_generator>
                        </entity>
                     </additional>
                  </entity>
               </target_node>
            </range>
         </link>
         <link>
            <path>
               <source_relation>
                  <relation>C_Shelf</relation>
               </source_relation>
               <target_relation>
                  <relationship>marinetlo:LC16_is_composed_of</relationship>
